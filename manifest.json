{
  "manifest_version": 2,
  "name": "Rebrickable MOC Downloader",
  "version": "1.9.1",
  "description": "Downloads inventory formats from the Rebrickable MOC open in the active tab.",
  "permissions": ["tabs", "downloads", "storage", "https://rebrickable.com/*"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Download MOC files",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rebrickable-moc-downloader@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
